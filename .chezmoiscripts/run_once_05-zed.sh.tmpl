#!/bin/bash
# Zed editor: install via official script for proper CLI support

{{- if ne .chezmoi.os "linux" }}
exit 0
{{- end }}

set -euo pipefail

if command -v zed &>/dev/null; then
    echo "==> Zed already installed: $(zed --version)"
    exit 0
fi

echo "==> Installing Zed editor..."
curl -f https://zed.dev/install.sh | sh
echo "==> Zed installed"
