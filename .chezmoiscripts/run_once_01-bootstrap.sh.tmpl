#!/bin/bash
# Bootstrap script: installs paru AUR helper on Arch Linux
# Only runs once per machine via chezmoi run_once_

{{- if ne .chezmoi.os "linux" }}
# Not Linux, skipping bootstrap
exit 0
{{- end }}

set -euo pipefail

# Check if this is an Arch-based system
if ! command -v pacman &>/dev/null; then
    echo "Not an Arch-based system, skipping bootstrap"
    exit 0
fi

echo "==> Bootstrapping Arch Linux system..."

# Ensure base-devel and git are installed
if ! pacman -Qi base-devel &>/dev/null; then
    echo "==> Installing base-devel..."
    sudo pacman -S --needed --noconfirm base-devel
fi

if ! command -v git &>/dev/null; then
    echo "==> Installing git..."
    sudo pacman -S --needed --noconfirm git
fi

# Install paru if not present
if ! command -v paru &>/dev/null; then
    echo "==> Installing paru AUR helper..."
    tmpdir=$(mktemp -d)
    git clone https://aur.archlinux.org/paru.git "$tmpdir/paru"
    (cd "$tmpdir/paru" && makepkg -si --noconfirm)
    rm -rf "$tmpdir"
    echo "==> paru installed successfully"
else
    echo "==> paru already installed"
fi

echo "==> Bootstrap complete!"
