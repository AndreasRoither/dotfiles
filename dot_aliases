# ----------------------
# Docker Functions
# ----------------------

# Execute bash/sh in a running container
dsh() {
    docker exec -it "$1" sh -c "if command -v bash > /dev/null; then bash; else sh; fi"
}

# Stop all running containers
dstopall() {
    docker stop $(docker ps -q) 2>/dev/null || echo "No running containers"
}

# Remove all stopped containers
drmall() {
    docker rm $(docker ps -aq) 2>/dev/null || echo "No containers to remove"
}

# Remove all images
drmiall() {
    docker rmi $(docker images -q) 2>/dev/null || echo "No images to remove"
}

# Show container logs with timestamps
dlogst() {
    docker logs -f --timestamps "$1"
}

# Inspect container environment variables
denv() {
    docker inspect --format '{{range .Config.Env}}{{println .}}{{end}}' "$1"
}

# Get container resource usage
duse() {
    docker stats --no-stream --format "table {{.Name}}\t{{.CPUPerc}}\t{{.MemUsage}}\t{{.MemPerc}}\t{{.PIDs}}"
}

# Follow logs for a compose service
dclogsf() {
    docker compose logs -f "$1"
}

# Restart a specific compose service
dcrs() {
    docker compose restart "$1"
}

# Rebuild and restart a specific service
dcrebuild() {
    docker compose up -d --build --no-deps "$1"
}

# Shell into a compose service
dcsh() {
    docker compose exec "$1" sh -c "if command -v bash > /dev/null; then bash; else sh; fi"
}

# Show container ports
dports() {
    docker ps --format "table {{.Names}}\t{{.Ports}}"
}

# Clean up everything (containers, images, volumes, networks)
dnuke() {
    echo "This will remove all containers, images, volumes, and networks. Continue? (y/N)"
    read -r response
    if [[ "$response" =~ ^[Yy]$ ]]; then
        docker stop $(docker ps -q) 2>/dev/null
        docker system prune -af --volumes
        echo "Docker cleaned!"
    fi
}

# Tail last N lines of container logs (default 100)
dtail() {
    local lines=${2:-100}
    docker logs --tail "$lines" -f "$1"
}

# Copy file from container
dcp() {
    docker cp "$1:$2" "$3"
}

# Show docker disk usage
ddf() {
    docker system df -v
}
